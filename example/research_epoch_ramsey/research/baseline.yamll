title: Triangle-union control baseline
tags: ['baseline', 'ramsey']
abstract: Deterministic valid baseline using disjoint unions of triangles plus a singleton gadget for odd n. It should produce informative secondary metrics while keeping binary score 0.
content: |
    def solution(n: int) -> str:
        if not isinstance(n, int):
            raise TypeError("n must be an integer")
        if n < 1:
            raise ValueError("n must be positive")

        edges = []
        next_vertex = 1

        triangle_count = n // 2
        for _ in range(triangle_count):
            a = next_vertex
            b = next_vertex + 1
            c = next_vertex + 2
            edges.append(f"{{{a},{b}}}")
            edges.append(f"{{{b},{c}}}")
            edges.append(f"{{{a},{c}}}")
            next_vertex += 3

        if n % 2 == 1:
            edges.append(f"{{{next_vertex}}}")

        return ",".join(edges)
